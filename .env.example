# The launcher copies this to .env once; never commit real secrets.
# Hosting environment variables take priority over .env.
DISCORD_TOKEN=
# Optional member screening: enable Server Members Intent in Discord first.
ENABLE_MEMBER_SCREENING_EVENTS=false
DEV_GUILD_ID=
DATABASE_PATH=data/espresso.db

# Application ID and OAuth2 Client Secret (different from the bot token).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Register this OAuth2 redirect in the Discord portal:
# http://localhost:8080/auth/discord/callback
WEB_BASE_URL=http://localhost:8080
WEB_HOST=127.0.0.1
WEB_PORT=8080

# Production, behind an HTTPS reverse proxy:
# WEB_BASE_URL=https://espresso.harperurias.com
# Callback: https://espresso.harperurias.com/auth/discord/callback
